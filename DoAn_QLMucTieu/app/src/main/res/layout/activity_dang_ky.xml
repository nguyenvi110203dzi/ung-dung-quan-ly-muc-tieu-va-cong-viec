<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DangKy"
    android:orientation="vertical"
    android:background="@drawable/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💥ĐĂNG KÝ💥"
            android:textSize="20pt"
            android:textColor="#000000"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="5dp" />

        <!-- Nhập Tên Tài Khoản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên tài khoản"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="6pt" />
            <EditText
                android:id="@+id/etTen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tên tài khoản"
                android:padding="12dp"
                android:background="#E6E6E6"
                android:textColorHint="#9E9E9E" />
        </LinearLayout>

        <!-- Nhập Tài Khoản -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">


        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email:"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="7pt"/>
            <EditText
                android:id="@+id/etTaiKhoan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="example@gmail.com"
                android:padding="12dp"
                android:background="#E6E6E6"
                android:textColorHint="#9E9E9E" />
        </LinearLayout>

        <!-- Nhập Mật Khẩu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu:"
                android:textColor="#000000"
                android:textSize="7pt"
                android:textStyle="bold"
                android:layout_gravity="center_vertical" />
            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:hint="Nhập mật khẩu"
                android:padding="12dp"
                android:background="#E6E6E6"
                android:textColorHint="#9E9E9E" />
        </LinearLayout>

        <!-- Chọn Role -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="#F8F8F8"
            android:elevation="4dp"
            android:layout_marginHorizontal="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎭 Chọn vai trò của bạn:"
                android:textColor="#673AB7"
                android:textSize="12pt"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp" />



                <!-- Lựa chọn User -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <RadioGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">
                    <RadioButton
                        android:id="@+id/rdbUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#4CAF50"
                        android:checked="true"
                        android:textColor="#000000"
                        android:text="👤 Người dùng"
                        android:textSize="9pt"
                        android:layout_weight="1"/>
                    <RadioButton
                        android:id="@+id/rdbAdmin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#F44336"
                        android:textColor="#000000"
                        android:text="🛠️Quản trị viên"
                        android:textSize="10pt"
                        android:layout_weight="1"/>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
        <!-- Nút Đăng Ký -->
        <Button
            android:id="@+id/btnDangKy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✨ Đăng Ký ✨"
            android:textColor="#FFF5F5"
            android:padding="12dp"
            android:textSize="10pt"
            android:layout_marginTop="16dp" />

        <!-- Link Đăng Nhập -->
        <TextView
            android:id="@+id/tvDangNhap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Đã có tài khoản? Đăng nhập ngay!"
            android:textColor="#000000"
            android:textSize="9pt"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</LinearLayout>
