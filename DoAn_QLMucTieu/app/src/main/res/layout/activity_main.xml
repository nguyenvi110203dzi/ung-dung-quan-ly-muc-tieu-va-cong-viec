<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:gravity="center_horizontal"
    android:background="@drawable/bg">

    <!-- Phần Tiêu đề Gradient -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hãy đặt mục tiêu lớn, bắt đầu từ việc nhỏ, và kiên trì thực hiện mỗi ngày.🐓"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="19sp"
            android:gravity="center"
            android:layout_centerInParent="true" />

        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_below="@id/tvTitle"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>

    <!-- Phần nhập tài khoản -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TÊN ĐĂNG NHẬP"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="6pt" />

        <EditText
            android:id="@+id/etTaiKhoan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E6E6E6"
            android:hint="Nhập tài khoản của bạn"
            android:padding="12dp"
            android:textColorHint="#9E9E9E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MẬT KHẨU"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="6pt"
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/etMatKhau"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nhập mật khẩu của bạn"
            android:padding="12dp"
            android:background="#E6E6E6"
            android:inputType="textPassword"
            android:textColorHint="#9E9E9E" />
    </LinearLayout>

    <!-- Nút Đăng nhập -->
    <Button
        android:id="@+id/btnDangNhap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Đăng Nhập"
        android:textSize="10pt"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:padding="12dp" />

    <!-- Liên kết tạo tài khoản -->
    <TextView
        android:id="@+id/tvDangKy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bạn chưa có tài khoản? Đăng Kí"
        android:textColor="#388E3C"
        android:textStyle="bold"
        android:textSize="7pt"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:layout_gravity="center_horizontal" />
</LinearLayout>
